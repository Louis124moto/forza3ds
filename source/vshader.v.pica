; Forza3DS - PICA200 vertex shader
; v0 = position (model space), v1 = colour as four unsigned bytes
; projection = projection * view * model, tint = colour multiplier

.fvec projection[4]
.fvec tint

.constf myconst(1.0, 0.00392156862, 0.0, 0.0)
.alias  ones    myconst.xxxx
.alias  inv255  myconst.yyyy

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mul r1, inv255, inclr
	mul outclr, tint, r1
	end
.end
